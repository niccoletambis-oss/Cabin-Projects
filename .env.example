# Development defaults. Copy to .env; never commit real secrets.
APP_ENV=development
DATABASE_URL=postgresql://cabin:cabin_dev@localhost:5432/cabin?schema=public
# Production REQUIRED: APP_ENV=production; APP_URL=https://your-chosen-domain
# APP_ORIGIN is a legacy alias; when both are set they must agree.
# APP_URL=http://127.0.0.1:3000
# DIRECT_DATABASE_URL=postgresql://migration-user:secret@db:5432/cabin?sslmode=require&sslaccept=strict
# Production REQUIRED: verified TLS for application and CLI database access.
# DATABASE_SSL=verify-full
# DATABASE_SSL_CA_FILE=/run/secrets/postgres-ca.pem
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
SESSION_HOURS=8
# Production REQUIRED: independently generated 32 random bytes as 64 hex characters.
# SECURITY_HASH_KEY= (generate with openssl rand -hex 32)
# Sessions are random opaque tokens, SHA-256 hashed in DB; SESSION_SECRET is not used.
# Production REQUIRED: trusted proxy strips client-supplied value, sets validated IP,
# preserves canonical Host, redirects HTTP to HTTPS, and is the ONLY app ingress.
TRUST_PROXY=false
# TRUSTED_CLIENT_IP_HEADER=x-cabin-client-ip

# DATABASE development storage keeps private bytes in PostgreSQL, no local files.
# Production REQUIRED: s3, private bucket, region, and key pair OR managed identity.
FILE_STORAGE_PROVIDER=database
# FILE_STORAGE_BUCKET=
# FILE_STORAGE_REGION=
# FILE_STORAGE_ACCESS_KEY=
# FILE_STORAGE_SECRET_KEY=
# FILE_STORAGE_USE_IDENTITY=true
# Optional S3-compatible endpoint (HTTPS mandatory in production)
# FILE_STORAGE_ENDPOINT=https://objects.your-provider.example
# FILE_STORAGE_PATH_STYLE=true
# FILE_STORAGE_KMS_KEY= (optional KMS key ID; default SSE-S3 AES256)

# Production REQUIRED: smtp; SMTP auth pair OR trusted relay/managed auth.
EMAIL_PROVIDER=none
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false (465 uses implicit TLS; other ports require STARTTLS)
# SMTP_FROM=operations@your-domain.example
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_IDENTITY=true (explicit trusted relay; library does not implement cloud OAuth)
# SMTP_CA_FILE=/run/secrets/smtp-ca.pem
DEV_RESET_LOG=false
# Only enable explicitly for loopback local development; never for shared environments.
MFA_MODE=disabled

RATE_LIMIT_BACKEND=postgres
# Defaults shown below are PRODUCTION limits. Dev login IP default is 300.
# RATE_LIMIT_LOGIN_IP=30 (per 15 minutes)
# RATE_LIMIT_LOGIN_ACCOUNT=10 (per 15 minutes)
# RATE_LIMIT_RESET_IP=10 (per 15 minutes)
# RATE_LIMIT_RESET_ACCOUNT=5 (per 15 minutes)
# RATE_LIMIT_RESET_SUBMIT=15 (per 15 minutes)
# RATE_LIMIT_UPLOAD=60 (per user, 5 minutes)
# RATE_LIMIT_MUTATION=120 (per user, minute)
MONITORING_PROVIDER=none
# MONITORING_WEBHOOK_URL=https://monitoring.your-domain.example/events
# MONITORING_TOKEN=

# Offline operator commands only. Supply via secret manager or private files.
# BACKUP_DIRECTORY=/private/backups
# BACKUP_KEY_FILE=/run/secrets/cabin-backup-key
# BACKUP_PREFIX=/private/backups/cabin-...
# RESTORE_TARGET_DATABASE_URL=postgresql://restore-user:secret@isolated-db:5432/restore_check
# RESTORE_CONFIRM=RESTORE_TO_EMPTY_DATABASE:restore_check
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD_FILE=/run/secrets/initial-admin-password
# ADMIN_RECOVERY_CONFIRM=RECOVER_ADMIN:your-admin-email
# Local verification only: use installed pg_dump/pg_restore by default.
# PG_TOOL_CONTAINER=cabin-projects-db-1
# Dev-only demo opt-ins; all seeds reject either production environment mode.
# ALLOW_DEMO_ACCOUNTS=true
# ALLOW_DEMO_DATA=true

# Phase 5 private operator acceptance only. These never authorize public launch.
# Staging still requires APP_ENV=production and all production-mode variables above.
# DEPLOYMENT_TIER=staging
# STAGING_ACCEPTANCE_CONFIRM=https://your-isolated-staging-origin.example
# Local Docker acceptance only; never point at production.
# DOCKER_ACCEPTANCE_IMAGE=cabin-operations:phase5
# DOCKER_ACCEPTANCE_NETWORK=cabin-projects_default
# DOCKER_ACCEPTANCE_DB_HOST=db
# DOCKER_ACCEPTANCE_PORT=3004
