generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  CARETAKER
}

enum TransactionType {
  IN
  OUT
}

enum ReportType {
  DAMAGE
  MISSING
  BROKEN
  LOST
  STAINED
  FOR_REPAIR
  FOR_REPLACEMENT
}

enum LinenStatus {
  AVAILABLE
  ASSIGNED_TO_ROOM
  USED
  FOR_LAUNDRY
  IN_LAUNDRY
  DAMAGED
  STAINED
  MISSING
  FOR_REPLACEMENT
  CLEAN
  IN_USE
  LAUNDRY
  RETIRED
}

model User {
  resetTokens        PasswordResetToken[]
  storedFiles        StoredFile[]
  roomAssignments    LocationAssignment[]
  bookingsCreated    Booking[]
  inspections        StayInspection[]
  linenMovements     LinenMovement[]
  expensesRecorded   Expense[]            @relation("ExpenseRecorder")
  expensesReviewed   Expense[]            @relation("ExpenseReviewer")
  chargesCreated     GuestCharge[]        @relation("ChargeCreator")
  chargesReviewed    GuestCharge[]        @relation("ChargeReviewer")
  chargesApproved    GuestCharge[]        @relation("ChargeApprover")
  damageReviewed     DamageReport[]       @relation("DamageReviewer")
  id                 String               @id @default(cuid())
  name               String
  passwordHash       String?
  active             Boolean              @default(true)
  lastLogin          DateTime?
  failedLogins       Int                  @default(0)
  lockedUntil        DateTime?
  sessions           Session[]
  requestedPurchases Purchase[]           @relation("Requester")
  approvedPurchases  Purchase[]           @relation("Approver")
  receivedPurchases  Purchase[]           @relation("Receiver")
  reviewedAudits     InventoryAudit[]     @relation("AuditReviewer")
  email              String               @unique
  role               Role                 @default(CARETAKER)
  createdAt          DateTime             @default(now())
  transactions       StockTransaction[]
  audits             InventoryAudit[]
  reports            DamageReport[]
  logs               ActivityLog[]
}

model Category {
  id    String          @id @default(cuid())
  name  String          @unique
  items InventoryItem[]
}

model Location {
  privateAttachments PrivateAttachment[]
  type               LocationType         @default(AREA)
  active             Boolean              @default(true)
  assignments        LocationAssignment[]
  roomInventory      RoomInventory[]
  bookingRooms       BookingRoom[]
  inspections        StayInspection[]
  linenBalances      LinenBalance[]
  linenFrom          LinenMovement[]      @relation("LinenFrom")
  linenTo            LinenMovement[]      @relation("LinenTo")
  id                 String               @id @default(cuid())
  name               String               @unique
  description        String?
  audits             InventoryAudit[]
  reports            DamageReport[]
  items              InventoryItem[]
}

model InventoryItem {
  roomInventory   RoomInventory[]
  inspectionLines StayInspectionLine[]
  linenEnrollment LinenEnrollment?
  linenBalances   LinenBalance[]
  linenMovements  LinenMovement[]
  id              String               @id @default(cuid())
  name            String
  sku             String               @unique
  description     String?
  brand           String?
  reorderQuantity Int                  @default(5)
  supplierId      String?
  supplier        Supplier?            @relation(fields: [supplierId], references: [id])
  condition       ItemCondition        @default(GOOD)
  status          ItemStatus           @default(ACTIVE)
  datePurchased   DateTime?
  notes           String?
  unit            String               @default("pcs")
  quantity        Int                  @default(0)
  minimumStock    Int                  @default(0)
  unitCost        Decimal              @default(0) @db.Decimal(12, 2)
  categoryId      String
  category        Category             @relation(fields: [categoryId], references: [id])
  locationId      String
  location        Location             @relation(fields: [locationId], references: [id])
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  transactions    StockTransaction[]
  purchaseLines   PurchaseLine[]
  auditLines      AuditLine[]
  reports         DamageReport[]
  linenEntries    LinenTracking[]

  @@index([categoryId, locationId])
  @@index([name])
}

model StockTransaction {
  id        String          @id @default(cuid())
  itemId    String
  item      InventoryItem   @relation(fields: [itemId], references: [id])
  type      TransactionType
  quantity  Int
  note      String
  userId    String?
  user      User?           @relation(fields: [userId], references: [id])
  createdAt DateTime        @default(now())

  @@index([createdAt])
}

model Supplier {
  expenses      Expense[]
  id            String          @id @default(cuid())
  name          String
  contactPerson String?
  address       String?
  notes         String?
  active        Boolean         @default(true)
  items         InventoryItem[]
  email         String?
  phone         String?
  purchases     Purchase[]
}

model Purchase {
  privateAttachments PrivateAttachment[]
  id                 String              @id @default(cuid())
  reference          String              @unique
  status             PurchaseStatus      @default(DRAFT)
  notes              String?
  requestedById      String?
  requestedBy        User?               @relation("Requester", fields: [requestedById], references: [id])
  approvedById       String?
  approvedBy         User?               @relation("Approver", fields: [approvedById], references: [id])
  approvedAt         DateTime?
  receivedById       String?
  receivedBy         User?               @relation("Receiver", fields: [receivedById], references: [id])
  supplierId         String
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  purchasedAt        DateTime            @default(now())
  receivedAt         DateTime?
  lines              PurchaseLine[]
  expenses           Expense[]
}

model PurchaseLine {
  id         String        @id @default(cuid())
  purchaseId String
  purchase   Purchase      @relation(fields: [purchaseId], references: [id])
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id])
  quantity   Int
  unitCost   Decimal       @db.Decimal(12, 2)
}

model InventoryAudit {
  id            String      @id @default(cuid())
  status        AuditStatus @default(IN_PROGRESS)
  locationId    String?
  location      Location?   @relation(fields: [locationId], references: [id])
  reviewRemarks String?
  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    User?       @relation("AuditReviewer", fields: [reviewedById], references: [id])
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  note          String?
  createdAt     DateTime    @default(now())
  completedAt   DateTime?
  lines         AuditLine[]
}

model AuditLine {
  id               String         @id @default(cuid())
  auditId          String
  audit            InventoryAudit @relation(fields: [auditId], references: [id])
  itemId           String
  item             InventoryItem  @relation(fields: [itemId], references: [id])
  expectedQuantity Int
  condition        ItemCondition  @default(GOOD)
  remarks          String?
  countedQuantity  Int

  @@unique([auditId, itemId])
}

model DamageReport {
  bookingId         String?
  booking           Booking?            @relation(fields: [bookingId], references: [id])
  inspectionLineId  String?             @unique
  inspectionLine    StayInspectionLine? @relation(fields: [inspectionLineId], references: [id])
  reviewedAt        DateTime?
  reviewedById      String?
  reviewedBy        User?               @relation("DamageReviewer", fields: [reviewedById], references: [id])
  guestCharge       GuestCharge?
  expenses          Expense[]
  id                String              @id @default(cuid())
  itemId            String
  item              InventoryItem       @relation(fields: [itemId], references: [id])
  userId            String?
  user              User?               @relation(fields: [userId], references: [id])
  type              ReportType
  locationId        String?
  location          Location?           @relation(fields: [locationId], references: [id])
  status            DamageStatus        @default(PENDING)
  estimatedCost     Decimal?            @db.Decimal(12, 2)
  managementRemarks String?
  photos            PhotoEvidence[]
  quantity          Int
  description       String
  resolvedAt        DateTime?
  createdAt         DateTime            @default(now())

  @@index([status, createdAt])
  @@index([bookingId])
}

model LinenTracking {
  id        String        @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id])
  status    LinenStatus
  quantity  Int
  note      String?
  createdAt DateTime      @default(now())
}

model Expense {
  reference      String?               @unique
  category       ExpenseCategory       @default(OTHER)
  payee          String?
  supplierId     String?
  supplier       Supplier?             @relation(fields: [supplierId], references: [id])
  paymentMethod  PaymentMethod         @default(CASH)
  receiptNumber  String?
  notes          String?
  status         ExpenseStatus         @default(SUBMITTED)
  recordedById   String?
  recordedBy     User?                 @relation("ExpenseRecorder", fields: [recordedById], references: [id])
  reviewedById   String?
  reviewedBy     User?                 @relation("ExpenseReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  damageReportId String?
  damageReport   DamageReport?         @relation(fields: [damageReportId], references: [id])
  bookingId      String?
  booking        Booking?              @relation(fields: [bookingId], references: [id])
  attachments    OperationAttachment[]
  id             String                @id @default(cuid())
  description    String
  amount         Decimal               @db.Decimal(12, 2)
  currency       String                @default("PHP")
  purchaseId     String?
  purchase       Purchase?             @relation(fields: [purchaseId], references: [id])
  incurredAt     DateTime              @default(now())

  @@index([incurredAt])
  @@index([recordedById, incurredAt])
}

model ActivityLog {
  requestId String?
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  role      Role?
  action    String
  entityId  String?
  details   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

enum ItemCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
  FOR_REPAIR
  FOR_REPLACEMENT
  MISSING
  DISPOSED
}

enum ItemStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum DamageStatus {
  PENDING
  UNDER_REVIEW
  FOR_REPAIR
  FOR_REPLACEMENT
  REPLACED
  WRITTEN_OFF
  RESOLVED
}

enum AuditStatus {
  IN_PROGRESS
  FOR_REVIEW
  REVIEWED
  ADJUSTED
}

enum PurchaseStatus {
  DRAFT
  FOR_APPROVAL
  APPROVED
  PURCHASED
  RECEIVED
  CANCELLED
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model PhotoEvidence {
  storedFileId String?
  storedFile   StoredFile?  @relation(fields: [storedFileId], references: [id])
  id           String       @id @default(cuid())
  reportId     String
  report       DamageReport @relation(fields: [reportId], references: [id])
  contentType  String
  data         Bytes
  createdAt    DateTime     @default(now())
}

enum LocationType {
  ROOM
  AREA
  STORAGE
  LAUNDRY
}

enum BookingSource {
  DIRECT
  AIRBNB
  BOOKING_COM
  AGODA
  FACEBOOK
  WALK_IN
  OTHER
}

enum BookingStatus {
  UPCOMING
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum InspectionType {
  CHECK_IN
  CHECK_OUT
}

enum StayCondition {
  GOOD
  MINOR_DAMAGE
  DAMAGED
  MISSING
  STAINED
}

enum InspectionStatus {
  DRAFT
  COMPLETED
}

enum GuestChargeStatus {
  DRAFT
  FOR_REVIEW
  APPROVED
  WAIVED
  PAID
  UNPAID
  CANCELLED
}

enum ChargePaymentStatus {
  NOT_DUE
  UNPAID
  PAID
  WAIVED
}

enum ExpenseCategory {
  INVENTORY_PURCHASE
  CLEANING_SUPPLIES
  LAUNDRY
  MAINTENANCE
  REPAIR
  REPLACEMENT_ITEM
  UTILITIES
  POOL_MAINTENANCE
  GARDEN_OUTDOOR
  GUEST_AMENITIES
  STAFF_CARETAKER
  OTHER
}

enum PaymentMethod {
  CASH
  GCASH
  BANK_TRANSFER
  CREDIT_CARD
  OTHER
}

enum ExpenseStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

model LocationAssignment {
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  @@id([locationId, userId])
}

model RoomInventory {
  id               String        @id @default(cuid())
  locationId       String
  location         Location      @relation(fields: [locationId], references: [id])
  itemId           String
  item             InventoryItem @relation(fields: [itemId], references: [id])
  expectedQuantity Int
  assignedQuantity Int
  condition        ItemCondition @default(GOOD)
  replacementCost  Decimal       @db.Decimal(12, 2)
  notes            String?
  updatedAt        DateTime      @updatedAt

  @@unique([locationId, itemId])
}

model LinenEnrollment {
  itemId    String        @id
  item      InventoryItem @relation(fields: [itemId], references: [id])
  createdAt DateTime      @default(now())
}

model LinenBalance {
  id         String        @id @default(cuid())
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id])
  status     LinenStatus
  locationId String
  location   Location      @relation(fields: [locationId], references: [id])
  quantity   Int           @default(0)

  @@unique([itemId, status, locationId])
}

model LinenMovement {
  id                 String        @id @default(cuid())
  itemId             String
  item               InventoryItem @relation(fields: [itemId], references: [id])
  quantity           Int
  previousStatus     LinenStatus?
  newStatus          LinenStatus
  previousLocationId String?
  previousLocation   Location?     @relation("LinenFrom", fields: [previousLocationId], references: [id])
  newLocationId      String
  newLocation        Location      @relation("LinenTo", fields: [newLocationId], references: [id])
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  notes              String
  createdAt          DateTime      @default(now())

  @@index([createdAt])
}

model Booking {
  privacyArchivedAt  DateTime?
  legalHold          Boolean             @default(false)
  privateAttachments PrivateAttachment[]
  id                 String              @id @default(cuid())
  reference          String              @unique
  guestName          String
  mobile             String?
  email              String?
  guestCount         Int
  checkInDate        DateTime            @db.Date
  checkOutDate       DateTime            @db.Date
  source             BookingSource
  notes              String?
  status             BookingStatus       @default(UPCOMING)
  createdById        String
  createdBy          User                @relation(fields: [createdById], references: [id])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  checkedInAt        DateTime?
  checkedOutAt       DateTime?
  rooms              BookingRoom[]
  inspections        StayInspection[]
  damageReports      DamageReport[]
  charges            GuestCharge[]
  expenses           Expense[]

  @@index([checkInDate, checkOutDate, status])
  @@index([status, checkInDate])
}

model BookingRoom {
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  @@id([bookingId, locationId])
}

model StayInspection {
  id          String               @id @default(cuid())
  bookingId   String
  booking     Booking              @relation(fields: [bookingId], references: [id])
  locationId  String
  location    Location             @relation(fields: [locationId], references: [id])
  type        InspectionType
  status      InspectionStatus     @default(DRAFT)
  userId      String
  user        User                 @relation(fields: [userId], references: [id])
  notes       String?
  createdAt   DateTime             @default(now())
  completedAt DateTime?
  lines       StayInspectionLine[]

  @@unique([bookingId, locationId, type])
}

model StayInspectionLine {
  id                String                @id @default(cuid())
  inspectionId      String
  inspection        StayInspection        @relation(fields: [inspectionId], references: [id])
  itemId            String
  item              InventoryItem         @relation(fields: [itemId], references: [id])
  itemName          String
  expectedQuantity  Int
  actualQuantity    Int
  condition         StayCondition         @default(GOOD)
  baselineQuantity  Int?
  baselineCondition StayCondition?
  replacementCost   Decimal               @db.Decimal(12, 2)
  notes             String?
  damageReport      DamageReport?
  attachments       OperationAttachment[]

  @@unique([inspectionId, itemId])
}

model GuestCharge {
  id              String              @id @default(cuid())
  reference       String              @unique
  bookingId       String
  booking         Booking             @relation(fields: [bookingId], references: [id])
  damageReportId  String              @unique
  damageReport    DamageReport        @relation(fields: [damageReportId], references: [id])
  quantity        Int
  replacementCost Decimal             @db.Decimal(12, 2)
  amount          Decimal             @db.Decimal(12, 2)
  reason          String
  notes           String?
  status          GuestChargeStatus   @default(DRAFT)
  paymentStatus   ChargePaymentStatus @default(NOT_DUE)
  createdById     String
  createdBy       User                @relation("ChargeCreator", fields: [createdById], references: [id])
  reviewedById    String?
  reviewedBy      User?               @relation("ChargeReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  approvedById    String?
  approvedBy      User?               @relation("ChargeApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status, createdAt])
}

model OperationAttachment {
  storedFileId     String?
  storedFile       StoredFile?         @relation(fields: [storedFileId], references: [id])
  id               String              @id @default(cuid())
  inspectionLineId String?
  inspectionLine   StayInspectionLine? @relation(fields: [inspectionLineId], references: [id])
  expenseId        String?
  expense          Expense?            @relation(fields: [expenseId], references: [id])
  contentType      String
  data             Bytes
  createdAt        DateTime            @default(now())
}

enum StoredFileProvider {
  DATABASE
  S3
}

enum StoredFileState {
  STAGED
  READY
  FAILED
  ARCHIVED
}

model StoredFile {
  id                 String                @id @default(uuid())
  objectKey          String                @unique
  provider           StoredFileProvider
  state              StoredFileState       @default(STAGED)
  originalName       String
  contentType        String
  size               Int
  originalSize       Int
  sha256             String
  storageVersion     String?
  data               Bytes?
  createdById        String?
  createdBy          User?                 @relation(fields: [createdById], references: [id])
  createdAt          DateTime              @default(now())
  archivedAt         DateTime?
  cleanupPending     Boolean               @default(false)
  photos             PhotoEvidence[]
  operations         OperationAttachment[]
  privateAttachments PrivateAttachment[]

  @@index([state, createdAt])
  @@index([createdById])
}

model PrivateAttachment {
  id           String     @id @default(cuid())
  storedFileId String
  storedFile   StoredFile @relation(fields: [storedFileId], references: [id])
  purchaseId   String?
  purchase     Purchase?  @relation(fields: [purchaseId], references: [id])
  bookingId    String?
  booking      Booking?   @relation(fields: [bookingId], references: [id])
  locationId   String?
  location     Location?  @relation(fields: [locationId], references: [id])
  notes        String
  createdAt    DateTime   @default(now())
}

model PasswordResetToken {
  credentialHash String
  id             String    @id @default(uuid())
  tokenHash      String    @unique
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, expiresAt])
}

model RateLimitBucket {
  keyHash   String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}
